# Файлы, которые не нужны сайтам: не попадают в архив пакета на Packagist.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/docs/contributing.md export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/rector.php         export-ignore
/resources/css      export-ignore
/resources/js       export-ignore
/scripts            export-ignore
/testbench.yaml     export-ignore
/tests              export-ignore
/workbench          export-ignore

# Собранные файлы не сравниваются построчно в diff.
/resources/dist/**  linguist-generated -diff
/resources/icons/** linguist-vendored
