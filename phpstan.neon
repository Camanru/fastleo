includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - config
        - routes
        - database
        - workbench/app
        - workbench/database
    excludePaths:
        - workbench/database/migrations/2026_11_04_200000_create_permission_tables.php
    ignoreErrors:
        # Трейт для тестов сайта: в самом пакете его никто не подключает (тесты пакета не анализируются).
        -
            identifier: trait.unused
            path: src/Testing/ActsAsFastleoUser.php
    # Конфиг пакета лежит в config/ корня пакета, а не в config_path() каркаса Testbench: env() там допустим.
    configDirectories:
        - config
    tmpDir: .phpstan.cache
