includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - config
        - routes
        - database
        - workbench/app
        - workbench/database
    excludePaths:
        - workbench/database/migrations/2026_11_04_200000_create_permission_tables.php
    tmpDir: .phpstan.cache
