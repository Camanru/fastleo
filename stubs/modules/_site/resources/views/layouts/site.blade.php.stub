    <footer>
        @includeIf('menu.footer')

        @if ($phone = fastleo_setting('contacts.phone'))
            <p><a href="tel:{{ preg_replace('/[^+\d]/', '', (string) $phone) }}">{{ $phone }}</a></p>
        @endif
        @if ($email = fastleo_setting('contacts.email'))
            <p><a href="mailto:{{ $email }}">{{ $email }}</a></p>
        @endif
        @if ($address = fastleo_setting('contacts.address'))
            <p>{{ $address }}</p>
        @endif
    </footer>
