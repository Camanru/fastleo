<?php

declare(strict_types=1);

namespace Database\Seeders\Fastleo;

use {{ namespace }}\Models\News;
use Illuminate\Database\Seeder;

/**
 * Примеры новостей (php artisan db:seed --class=NewsSeeder).
 */
class NewsSeeder extends Seeder
{
    /**
     * Создать три новости, если таких адресов ещё нет.
     */
    public function run(): void
    {
        foreach ([1 => 'Открылся новый сайт', 2 => 'Мы обновили каталог', 3 => 'Расписание на праздники'] as $number => $title) {
            News::query()->firstOrCreate(['slug' => 'news-'.$number], [
                'title' => $title,
                'excerpt' => 'Коротко о том, что произошло.',
                'body' => '<p>Подробности добавьте в панели: раздел «Новости».</p>',
                'published_at' => now()->subDays($number),
                'is_published' => true,
            ]);
        }
    }
}
