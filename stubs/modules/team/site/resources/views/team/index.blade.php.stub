@extends('layouts.site')

@section('seo')
    <x-fastleo::seo title="Команда" />
@endsection

@section('content')
    <h1>Команда</h1>

    @forelse ($items as $item)
        <article>
            <a href="{{ route('site.team.show', $item->slug) }}">
                <x-fastleo::picture :src="$item->photo" :alt="$item->name" />
                <h2>{{ $item->name }}</h2>
            </a>
            @if ($item->job_title)
                <p>{{ $item->job_title }}</p>
            @endif
            @if ($item->experience)
                <p>{{ $item->experience }}</p>
            @endif
            @if ($item->excerpt)
                <p>{{ $item->excerpt }}</p>
            @endif
        </article>
    @empty
        <p>Сотрудников пока нет.</p>
    @endforelse

    <nav>
        @if ($items->previousPageUrl())
            <a href="{{ $items->previousPageUrl() }}" rel="prev">← Назад</a>
        @endif
        @if ($items->nextPageUrl())
            <a href="{{ $items->nextPageUrl() }}" rel="next">Дальше →</a>
        @endif
    </nav>
@endsection
