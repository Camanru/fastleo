<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ appNamespace }}\Models\Service;
use Fastleo\Fields\Image;
use Fastleo\Fields\RichText;
use Fastleo\Fields\Seo;
use Fastleo\Fields\Slug;
use Fastleo\Fields\Text;
use Fastleo\Fields\Textarea;
use Fastleo\Fields\Toggle;
use Fastleo\Resource;

/**
 * Раздел «Услуги»: название, адрес, категория, цена, обложка, описание и SEO. Порядок на сайте — перетаскиванием в списке.
 * Показ на сайте — публичная часть модуля (если вы поставили её при установке) или ваши маршруты и шаблоны: `Service::query()->published()->paginate(12)`.
 */
final class ServiceResource extends Resource
{
    protected static string $model = Service::class;

    protected static ?string $slug = 'services';

    protected static ?string $label = 'Услуги';

    protected static ?string $singular = 'Услуга';

    protected static ?string $group = 'Компания';

    protected static string $icon = 'concierge-bell';

    protected static int $position = 10;

    protected static ?string $sortColumn = 'sort';

    /**
     * Поля услуги.
     */
    public function fields(): array
    {
        return [
            Text::make('title', 'Название')->required()->searchable()->sortable(),
            Slug::make('slug', 'Адрес')->from('title'),
            Text::make('category', 'Категория')->maxLength(100)->help('Необязательно: по ней можно отбирать услуги на сайте («Ремонт», «Консультации»).')->sortable(),
            Text::make('price', 'Цена')->maxLength(100)->help('Текстом, как её увидят посетители: «от 1 500 ₽», «договорная».')->hideInList(),
            Image::make('cover', 'Обложка')->directory('services')->hideInList(),
            Textarea::make('excerpt', 'Кратко')->rows(3)->maxLength(5000)->hideInList(),
            RichText::make('body', 'Описание'),
            Toggle::make('is_published', 'Опубликована')->default(true)->quickToggle(),
            Seo::make('seo')->directory('services'),
        ];
    }
}
