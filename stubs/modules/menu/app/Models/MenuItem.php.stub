<?php

declare(strict_types=1);

namespace {{ appNamespace }}\Models;

use Database\Factories\MenuItemFactory;
use Illuminate\Database\Eloquent\Attributes\UseFactory;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

/**
 * Пункт меню сайта: дерево (`parent_id`), место (`header` — шапка, `footer` — подвал), адрес.
 * Вывод меню на сайте — шаблоны `resources/views/menu` (если вы поставили публичную часть при установке) или ваши: `MenuItem::tree('header')` отдаёт готовое дерево опубликованных пунктов.
 *
 * ```blade
 *
 * @foreach (\{{ appNamespace }}\Models\MenuItem::tree('header') as $item)
 *     <a href="{{ $item->url }}" @if ($item->new_tab) target="_blank" rel="noopener" @endif>{{ $item->title }}</a>
 *     @foreach ($item->children as $child) … @endforeach
 *
 * @endforeach
 * ```
 *
 * @property int $id
 * @property int|null $parent_id
 * @property int $sort
 * @property string $location
 * @property string $title
 * @property string $url
 * @property bool $new_tab
 * @property bool $is_published
 * @property-read Collection<int, MenuItem> $children заполняется только в `tree()`
 */
#[UseFactory(MenuItemFactory::class)]
class MenuItem extends Model
{
    use HasFactory;

    public const string HEADER = 'header';

    public const string FOOTER = 'footer';

    protected $fillable = ['parent_id', 'sort', 'location', 'title', 'url', 'new_tab', 'is_published'];

    /**
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'new_tab' => 'boolean',
            'is_published' => 'boolean',
        ];
    }

    /**
     * Родительский пункт.
     *
     * @return BelongsTo<MenuItem, $this>
     */
    public function parent(): BelongsTo
    {
        return $this->belongsTo(self::class, 'parent_id');
    }

    /**
     * Только опубликованные пункты в порядке, заданном в панели.
     *
     * @param  Builder<MenuItem>  $query
     */
    public function scopePublished(Builder $query): void
    {
        $query->where('is_published', true)->orderBy('sort')->orderBy('id');
    }

    /**
     * Дерево опубликованных пунктов места: корневые пункты, у каждого `children` (рекурсивно). Пункт скрытого родителя не попадает в дерево.
     * Один запрос на всё меню.
     *
     * @return Collection<int, MenuItem>
     */
    public static function tree(string $location = self::HEADER): Collection
    {
        $byParent = static::query()->published()->where('location', $location)->get()->groupBy(fn (MenuItem $item): int => (int) $item->parent_id);

        $attach = function (Collection $items) use (&$attach, $byParent): Collection {
            foreach ($items as $item) {
                $item->setRelation('children', $attach($byParent->get($item->id, new Collection)));
            }

            return $items;
        };

        return $attach($byParent->get(0, new Collection));
    }
}
