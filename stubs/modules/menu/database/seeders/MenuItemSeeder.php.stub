<?php

declare(strict_types=1);

namespace Database\Seeders;

use {{ appNamespace }}\Models\MenuItem;
use Illuminate\Database\Seeder;

/**
 * Примеры меню: «Главная» и «Контакты» в шапке, «Политика» в подвале (php artisan db:seed --class='Database\Seeders\MenuItemSeeder').
 */
class MenuItemSeeder extends Seeder
{
    /**
     * Создать примеры, если пунктов с такими адресами ещё нет.
     */
    public function run(): void
    {
        foreach ([
            ['location' => MenuItem::HEADER, 'title' => 'Главная', 'url' => '/', 'sort' => 1],
            ['location' => MenuItem::HEADER, 'title' => 'Контакты', 'url' => '/contacts', 'sort' => 2],
            ['location' => MenuItem::FOOTER, 'title' => 'Политика конфиденциальности', 'url' => '/privacy', 'sort' => 1],
        ] as $item) {
            MenuItem::query()->firstOrCreate(['location' => $item['location'], 'url' => $item['url']], $item);
        }
    }
}
