<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ appNamespace }}\Models\MenuItem;
use Fastleo\Fields\BelongsTo;
use Fastleo\Fields\Select;
use Fastleo\Fields\Text;
use Fastleo\Fields\Toggle;
use Fastleo\Resource;
use Illuminate\Database\Eloquent\Builder;

/**
 * Раздел «Меню сайта»: дерево пунктов шапки и подвала, порядок — перетаскиванием.
 * Вывод на сайте — шаблоны `resources/views/menu` (если вы поставили публичную часть при установке) или ваши: `MenuItem::tree('header')`.
 */
final class MenuItemResource extends Resource
{
    protected static string $model = MenuItem::class;

    protected static ?string $slug = 'menu-items';

    protected static ?string $label = 'Меню сайта';

    protected static ?string $singular = 'Пункт меню';

    protected static string $icon = 'list-tree';

    protected static int $position = 5;

    protected static ?string $treeColumn = 'parent_id';

    protected static ?string $sortColumn = 'sort';

    /**
     * Поля пункта меню.
     */
    public function fields(): array
    {
        return [
            Text::make('title', 'Название')->required()->maxLength(150)->searchable()->sortable(),
            Text::make('url', 'Адрес')->required()->maxLength(500)
                ->help('Адрес вида /contacts или https://… (вложенные пункты и порядок — в списке, перетаскиванием).')
                ->rules(['regex:~^(/(?![/\\\\\x00-\x20])|https?://)~i']),
            Select::make('location', 'Где показывать')->options([MenuItem::HEADER => 'Шапка', MenuItem::FOOTER => 'Подвал'])->default(MenuItem::HEADER)->required(),
            // Пункт показывается в своём месте, а вложенные берутся из него же: родитель из шапки у пункта подвала не нашёл бы
            // своего места нигде, поэтому варианты родителя — только пункты выбранного места.
            BelongsTo::make('parent_id', 'Родитель')->hideInList()
                ->dependsOn('location', fn (Builder $query, mixed $location) => $query->where('location', $location ?? MenuItem::HEADER)),
            Toggle::make('new_tab', 'Открывать в новой вкладке')->hideInList(),
            Toggle::make('is_published', 'Показывать')->default(true)->quickToggle(),
        ];
    }
}
