<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ appNamespace }}\Models\Partner;
use Fastleo\Fields\Image;
use Fastleo\Fields\Text;
use Fastleo\Fields\Toggle;
use Fastleo\Fields\Url;
use Fastleo\Resource;

/**
 * Раздел «Партнёры и клиенты»: название, логотип, ссылка и краткое описание. Порядок на сайте — перетаскиванием в списке.
 * Показ на сайте — публичная часть модуля (если вы поставили её при установке) или ваши маршруты и шаблоны: `Partner::query()->published()->get()`.
 */
final class PartnerResource extends Resource
{
    protected static string $model = Partner::class;

    protected static ?string $slug = 'partners';

    protected static ?string $label = 'Партнёры и клиенты';

    protected static ?string $singular = 'Партнёр';

    protected static ?string $group = 'Компания';

    protected static string $icon = 'handshake';

    protected static int $position = 60;

    protected static ?string $sortColumn = 'sort';

    /**
     * Поля партнёра.
     */
    public function fields(): array
    {
        return [
            Text::make('name', 'Название')->required()->maxLength(255)->searchable()->sortable(),
            Image::make('logo', 'Логотип')->directory('partners')->hideInList(),
            Url::make('url', 'Сайт')->maxLength(500)->help('Необязательно: адрес вида https://… — логотип на сайте станет ссылкой.')->hideInList(),
            Text::make('description', 'Описание')->maxLength(255)->hideInList(),
            Toggle::make('is_published', 'Показывать')->default(true)->quickToggle(),
        ];
    }
}
