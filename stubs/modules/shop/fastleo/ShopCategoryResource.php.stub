<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ appNamespace }}\Models\ShopCategory;
use {{ appNamespace }}\Models\ShopProduct;
use Fastleo\Fields\BelongsTo;
use Fastleo\Fields\Seo;
use Fastleo\Fields\Slug;
use Fastleo\Fields\Text;
use Fastleo\Fields\Toggle;
use Fastleo\Resource;
use Fastleo\Support\OperationCancelled;
use Illuminate\Database\Eloquent\Model;
use Override;

/**
 * Раздел «Категории» магазина: дерево с ручным порядком (перетаскиванием). Показ на сайте — `ShopController` и шаблоны
 * `resources/views/shop` публичной части модуля (если вы поставили её при установке): `ShopCategory::query()->visible()->whereNull('parent_id')->get()`.
 */
final class ShopCategoryResource extends Resource
{
    protected static string $model = ShopCategory::class;

    protected static ?string $slug = 'shop-categories';

    protected static ?string $label = 'Категории';

    protected static ?string $singular = 'Категория';

    protected static string $icon = 'folder-tree';

    protected static ?string $group = 'Магазин';

    protected static int $position = 30;

    protected static ?string $treeColumn = 'parent_id';

    protected static ?string $sortColumn = 'sort';

    /**
     * Поля категории.
     */
    public function fields(): array
    {
        return [
            Text::make('title', 'Название')->required()->maxLength(150)->searchable()->sortable(),
            Slug::make('slug', 'Адрес')->from('title'),
            BelongsTo::make('parent_id', 'Родитель')->hideInList(),
            Toggle::make('is_published', 'Показывать')->default(true)->quickToggle(),
            Seo::make('seo')->directory('shop'),
        ];
    }

    /**
     * Категорию с товарами или подкатегориями не удалить: товар без категории доступен покупателям, и удаление скрытой категории
     * открыло бы её товары в каталоге. Сначала перенесите или удалите товары и подкатегории.
     */
    #[Override]
    public function beforeDelete(Model $record): void
    {
        if (ShopProduct::query()->where('category_id', $record->getKey())->exists() || ShopCategory::query()->where('parent_id', $record->getKey())->exists()) {
            throw new OperationCancelled('В категории есть товары или подкатегории: сначала перенесите или удалите их.');
        }
    }
}
