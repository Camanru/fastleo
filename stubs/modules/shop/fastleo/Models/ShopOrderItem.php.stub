<?php

declare(strict_types=1);

namespace {{ namespace }}\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

/**
 * Позиция заказа: снимок названия, артикула и цены на момент заказа (товар могут изменить или удалить).
 *
 * @property int $id
 * @property int $order_id
 * @property int|null $product_id
 * @property string $title
 * @property string|null $sku
 * @property string $price
 * @property int $quantity
 * @property bool $stock_taken
 */
class ShopOrderItem extends Model
{
    public $timestamps = false;

    protected $fillable = ['order_id', 'product_id', 'title', 'sku', 'price', 'quantity', 'stock_taken'];

    /**
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'price' => 'decimal:2',
            'quantity' => 'integer',
            'stock_taken' => 'boolean',
        ];
    }

    /**
     * Заказ.
     *
     * @return BelongsTo<ShopOrder, $this>
     */
    public function order(): BelongsTo
    {
        return $this->belongsTo(ShopOrder::class, 'order_id');
    }

    /**
     * Товар каталога (пусто, если его удалили).
     *
     * @return BelongsTo<ShopProduct, $this>
     */
    public function product(): BelongsTo
    {
        return $this->belongsTo(ShopProduct::class, 'product_id');
    }
}
