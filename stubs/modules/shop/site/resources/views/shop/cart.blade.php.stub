            <tbody>
                @foreach ($lines as $line)
                    <tr>
                        <td><a href="{{ route('site.shop.product', $line['product']->slug) }}">{{ $line['product']->title }}</a></td>
                        <td>{{ number_format((float) $line['product']->price, 2, ',', ' ') }} ₽</td>
                        <td>
                            <form method="POST" action="{{ route('site.shop.cart.update', $line['product']->id) }}">
                                @csrf
                                @method('PATCH')
                                <input type="number" name="quantity" value="{{ $line['quantity'] }}" min="0" max="99">
                                <button type="submit">Изменить</button>
                            </form>
                        </td>
                        <td>{{ number_format((float) $line['sum'], 2, ',', ' ') }} ₽</td>
                        <td>
                            <form method="POST" action="{{ route('site.shop.cart.remove', $line['product']->id) }}">
                                @csrf
                                @method('DELETE')
                                <button type="submit">Убрать</button>
                            </form>
                        </td>
                    </tr>
                @endforeach
            </tbody>
        </table>

