<?php

declare(strict_types=1);

namespace Database\Factories\Fastleo;

use {{ namespace }}\Models\ShopCategory;
use Illuminate\Database\Eloquent\Factories\Factory;
use Illuminate\Support\Str;

/**
 * Фабрика категорий магазина.
 *
 * @extends Factory<ShopCategory>
 */
class ShopCategoryFactory extends Factory
{
    protected $model = ShopCategory::class;

    /**
     * Опубликованная категория верхнего уровня.
     *
     * @return array<string, mixed>
     */
    public function definition(): array
    {
        $title = fake()->unique()->words(2, true);

        return ['title' => $title, 'slug' => Str::slug($title), 'is_published' => true, 'sort' => 0];
    }
}
