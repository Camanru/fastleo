<?php

declare(strict_types=1);

namespace {{ appNamespace }}\Models;

use Database\Factories\ShopProductFactory;
use Illuminate\Database\Eloquent\Attributes\UseFactory;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

/**
 * Товар каталога. На сайте его показывают `ShopController` и шаблоны `resources/views/shop` публичной части модуля (если вы поставили её при установке).
 *
 * ```php
 * ShopProduct::query()->available()->inStock()->where('category_id', $category->id)->paginate(24);
 * ShopProduct::query()->available()->where('slug', $slug)->firstOrFail();
 * ```
 *
 * `price` — строка с копейками (`'1500.00'`); `stock` — `null`, если остаток не учитывается.
 *
 * @property int $id
 * @property int|null $category_id
 * @property int $sort
 * @property string $title
 * @property string $slug
 * @property string|null $sku
 * @property string $price
 * @property int|null $stock
 * @property string|null $cover
 * @property list<string>|null $photos
 * @property string|null $description
 * @property array<string, string|null>|null $specs
 * @property bool $is_published
 * @property array{title?: string, description?: string, image?: string, noindex?: bool}|null $seo
 */
#[UseFactory(ShopProductFactory::class)]
class ShopProduct extends Model
{
    use HasFactory;

    protected $fillable = ['category_id', 'sort', 'title', 'slug', 'sku', 'price', 'stock', 'cover', 'photos', 'description', 'specs', 'is_published', 'seo'];

    /**
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'price' => 'decimal:2',
            'stock' => 'integer',
            'photos' => 'array',
            'specs' => 'array',
            'is_published' => 'boolean',
            'seo' => 'array',
        ];
    }

    /**
     * Категория товара.
     *
     * @return BelongsTo<ShopCategory, $this>
     */
    public function category(): BelongsTo
    {
        return $this->belongsTo(ShopCategory::class, 'category_id');
    }

    /**
     * Только опубликованные товары в порядке, заданном в панели.
     *
     * @param  Builder<ShopProduct>  $query
     */
    public function scopePublished(Builder $query): void
    {
        $query->where('is_published', true)->orderBy('sort')->orderByDesc('id');
    }

    /**
     * Товары, которые видит и покупает посетитель: опубликованные и не лежащие в скрытой категории (самой или родительской);
     * товар без категории доступен. Только этот критерий нужен каталогу, корзине и заказу.
     *
     * @param  Builder<ShopProduct>  $query
     */
    public function scopeAvailable(Builder $query): void
    {
        $query->published();

        if (($hidden = ShopCategory::hiddenIds()) !== []) {
            $query->where(fn (Builder $when) => $when->whereNull('category_id')->orWhereNotIn('category_id', $hidden));
        }
    }

    /**
     * Товары, которые можно купить: остаток не учитывается (`null`) или он больше нуля.
     *
     * @param  Builder<ShopProduct>  $query
     */
    public function scopeInStock(Builder $query): void
    {
        $query->where(fn (Builder $when) => $when->whereNull('stock')->orWhere('stock', '>', 0));
    }
}
