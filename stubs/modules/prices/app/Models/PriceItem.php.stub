<?php

declare(strict_types=1);

namespace {{ appNamespace }}\Models;

use Database\Factories\PriceItemFactory;
use Illuminate\Database\Eloquent\Attributes\UseFactory;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

/**
 * Позиция прайс-листа: название, цена, единица измерения и группа. Вывод на сайте — публичная часть модуля
 * (если вы поставили её при установке) или ваш.
 *
 * ```php
 * PriceItem::query()->published()->get()->groupBy('category');
 * ```
 *
 * @property int $id
 * @property string $title
 * @property string $price
 * @property string|null $unit
 * @property string|null $category
 * @property string|null $note
 * @property bool $is_published
 * @property int $sort
 */
#[UseFactory(PriceItemFactory::class)]
class PriceItem extends Model
{
    use HasFactory;

    protected $fillable = ['title', 'price', 'unit', 'category', 'note', 'is_published', 'sort'];

    /**
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'is_published' => 'boolean',
        ];
    }

    /**
     * Только опубликованные позиции в порядке, заданном в панели (перетаскиванием в списке).
     *
     * @param  Builder<PriceItem>  $query
     */
    public function scopePublished(Builder $query): void
    {
        $query->where('is_published', true)->orderBy('sort')->orderByDesc('id');
    }
}
