<?php

declare(strict_types=1);

namespace Database\Seeders\Fastleo;

use {{ namespace }}\Models\FaqItem;
use Illuminate\Database\Seeder;

/**
 * Примеры вопросов и ответов (php artisan db:seed --class=FaqItemSeeder).
 */
class FaqItemSeeder extends Seeder
{
    /**
     * Создать три вопроса, если таких ещё нет.
     */
    public function run(): void
    {
        foreach ([1 => 'Как сделать заказ?', 2 => 'Как оплатить?', 3 => 'Как связаться с вами?'] as $number => $question) {
            FaqItem::query()->firstOrCreate(['question' => $question], [
                'answer' => '<p>Ответ добавьте в панели: раздел «Вопросы и ответы».</p>',
                'is_published' => true,
                'sort' => $number,
            ]);
        }
    }
}
