@php
    $s = fn (mixed $value): string => is_string($value) ? trim($value) : '';
@endphp
@include('landing.partials.open', ['anchor' => $anchor ?? null, 'tone' => $tone ?? null])
    @include('landing.partials.heading')
    <div class="landing-cards">
        @foreach (is_array($rows ?? null) ? $rows : [] as $row)
            @continue(! is_array($row) || $s($row['title'] ?? null) === '')
            <article class="landing-card">
                @include('landing.partials.icon', ['name' => $row['icon'] ?? null])
                <h3>{{ $s($row['title']) }}</h3>
                @if ($s($row['text'] ?? null) !== '')
                    <p>{{ $s($row['text']) }}</p>
                @endif
                @include('landing.partials.button', ['label' => $row['btn_label'] ?? '', 'url' => $row['btn_url'] ?? '', 'topic' => $s($row['btn_topic'] ?? null) !== '' ? $row['btn_topic'] : $row['title'], 'class' => 'landing-btn'])
            </article>
        @endforeach
    </div>
    @if ($s($outro ?? null) !== '')
        <p class="landing-outro">{{ $s($outro ?? null) }}</p>
    @endif
@include('landing.partials.close')
