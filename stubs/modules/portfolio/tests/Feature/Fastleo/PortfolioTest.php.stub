<?php

declare(strict_types=1);

use {{ namespace }}\Models\PortfolioItem;
use {{ appNamespace }}\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;

uses(RefreshDatabase::class);

it('keeps only published works in the order set in the panel', function (): void {
    PortfolioItem::factory()->create(['slug' => 'second', 'sort' => 2]);
    PortfolioItem::factory()->create(['slug' => 'first', 'sort' => 1]);
    PortfolioItem::factory()->create(['slug' => 'hidden', 'is_published' => false]);

    expect(PortfolioItem::query()->published()->pluck('slug')->all())->toBe(['first', 'second']);
});

it('lets an administrator add a work', function (): void {
    $admin = User::factory()->create();
    $admin->forceFill(['fastleo_admin' => true])->save();
    $this->actingAs($admin, 'fastleo');

    $this->get(route('fastleo.resources.index', 'portfolio'))->assertOk();
    $this->post(route('fastleo.resources.store', 'portfolio'), ['title' => 'Работа', 'slug' => 'rabota', 'is_published' => '1'])->assertRedirect();

    expect(PortfolioItem::query()->where('slug', 'rabota')->exists())->toBeTrue();
});
