<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ appNamespace }}\Models\Branch;
use Fastleo\Fields\Email;
use Fastleo\Fields\Image;
use Fastleo\Fields\Number;
use Fastleo\Fields\Text;
use Fastleo\Fields\Textarea;
use Fastleo\Fields\Toggle;
use Fastleo\Resource;

/**
 * Раздел «Филиалы и адреса»: адрес, телефоны, часы работы и координаты для ссылки на карту. Порядок на сайте — перетаскиванием в списке.
 * Показ на сайте — публичная часть модуля (если вы поставили её при установке) или ваши маршруты и шаблоны:
 * `Branch::query()->published()->get()`, ссылка на карту — `$branch->mapUrl()`.
 */
final class BranchResource extends Resource
{
    protected static string $model = Branch::class;

    protected static ?string $slug = 'branches';

    protected static ?string $label = 'Филиалы и адреса';

    protected static ?string $singular = 'Филиал';

    protected static ?string $group = 'Компания';

    protected static string $icon = 'map-pin';

    protected static int $position = 40;

    protected static ?string $sortColumn = 'sort';

    /**
     * Поля филиала.
     */
    public function fields(): array
    {
        return [
            Text::make('name', 'Название')->required()->maxLength(255)->searchable()->sortable(),
            Text::make('city', 'Город')->maxLength(100)->searchable()->sortable(),
            Text::make('address', 'Адрес')->required()->maxLength(255)->searchable(),
            Textarea::make('phones', 'Телефоны')->rows(3)->maxLength(1000)->help('По одному номеру в строке, не больше десяти. Подпись и добавочный допустимы («Бухгалтерия: +7 343 000-00-01 доб. 12»), но ссылкой для звонка станет только первый номер.')->hideInList(),
            Email::make('email', 'Почта')->maxLength(150)->hideInList(),
            Textarea::make('working_hours', 'Часы работы')->rows(3)->maxLength(1000)->help('Как увидят посетители: «Пн–Пт 9:00–18:00».')->hideInList(),
            Number::make('latitude', 'Широта')->min(-90)->max(90)->help('Необязательно, вместе с долготой: тогда ссылка «Показать на карте» откроет точку (например, 55.7558).')->hideInList(),
            Number::make('longitude', 'Долгота')->min(-180)->max(180)->help('Необязательно, вместе с широтой (например, 37.6173).')->hideInList(),
            Image::make('photo', 'Фото')->directory('branches')->hideInList(),
            Toggle::make('is_published', 'Показывать')->default(true)->quickToggle(),
        ];
    }
}
