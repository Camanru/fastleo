<?php

declare(strict_types=1);

use {{ appNamespace }}\Models\Page;
use Illuminate\Foundation\Testing\RefreshDatabase;

uses(RefreshDatabase::class);

it('shows the home page at the root and the pages by their address', function (): void {
    Page::factory()->create(['title' => 'Добро пожаловать', 'slug' => 'home', 'is_home' => true]);
    $about = Page::factory()->create(['title' => 'О компании', 'slug' => 'about']);
    Page::factory()->create(['title' => 'Команда', 'slug' => 'team', 'parent_id' => $about->id]);

    $this->get('/')->assertOk()->assertSee('Добро пожаловать');
    $this->get('/about')->assertOk()->assertSee('О компании');
    $this->get('/about/team')->assertOk()->assertSee('Команда');
    $this->get('/home')->assertNotFound();
});

it('hides unpublished pages and the pages inside them', function (): void {
    $closed = Page::factory()->create(['slug' => 'closed', 'is_published' => false]);
    Page::factory()->create(['slug' => 'inner', 'parent_id' => $closed->id]);

    $this->get('/closed')->assertNotFound();
    $this->get('/closed/inner')->assertNotFound();
    $this->get('/.env')->assertNotFound();
});

it('shows the blocks of a page and keeps a link without a safe address out of the call to action', function (): void {
    Page::factory()->create(['slug' => 'blocks', 'content' => [
        ['type' => 'text', 'data' => ['body' => '<p>Текст блока</p>']],
        ['type' => 'cta', 'data' => ['title' => 'Позвоните', 'button' => 'Хорошо', 'url' => 'javascript:alert(1)']],
    ]]);

    $this->get('/blocks')->assertOk()->assertSee('<p>Текст блока</p>', false)->assertSee('Позвоните')->assertDontSee('javascript:', false);
});
