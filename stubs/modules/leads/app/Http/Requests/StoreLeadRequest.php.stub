<?php

declare(strict_types=1);

namespace {{ appNamespace }}\Http\Requests;

use Illuminate\Contracts\Encryption\DecryptException;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Support\Facades\Crypt;

/**
 * Заявка с формы сайта: проверка полей и защита от ботов без внешних сервисов.
 *
 * Форма сайта (POST /leads) отправляет поля `name`, `phone`, `email`, `message`, скрытое поле-ловушку `leave_empty`
 * (человеку его не видно, оно должно остаться пустым) и `form_token` — `StoreLeadRequest::token()`.
 *
 * ```blade
 * <form method="post" action="{{ route('site.leads.store') }}">
 *     @csrf
 *     <input type="hidden" name="form_token" value="{{ \{{ appNamespace }}\Http\Requests\StoreLeadRequest::token() }}">
 *     <div style="position: absolute; left: -9999px;" aria-hidden="true"><input type="text" name="leave_empty" tabindex="-1" autocomplete="off"></div>
 *     <input name="name" required> <input name="phone" required> <button>Отправить</button>
 * </form>
 * ```
 */
class StoreLeadRequest extends FormRequest
{
    /** Быстрее этого число секунд после показа формы человек её не отправит. */
    private const int MIN_SECONDS = 3;

    /** Форма старше суток считается устаревшей. */
    private const int MAX_SECONDS = 86400;

    /**
     * Метка времени показа формы для скрытого поля `form_token`: зашифрована и привязана к сессии посетителя.
     */
    public static function token(): string
    {
        return Crypt::encryptString(now()->timestamp.'|'.session()->getId());
    }

    /**
     * Форму может отправить любой посетитель.
     */
    public function authorize(): bool
    {
        return true;
    }

    /**
     * Правила полей.
     *
     * @return array<string, array<int, string>>
     */
    public function rules(): array
    {
        return [
            'name' => ['required', 'string', 'max:100'],
            'phone' => ['required', 'string', 'max:50', 'regex:/^[0-9+()\-\s.]{5,}$/'],
            'email' => ['nullable', 'email', 'max:255'],
            'message' => ['nullable', 'string', 'max:2000'],
            'leave_empty' => ['nullable', 'string', 'max:255'],
            'form_token' => ['nullable', 'string', 'max:1000'],
        ];
    }

    /**
     * Заявку отправил бот: заполнено скрытое поле-ловушка либо нет метки времени формы (или она подделана).
     * Такую заявку молча отбрасывают.
     */
    public function isBot(): bool
    {
        return $this->filled('leave_empty') || $this->secondsSinceShown() === null;
    }

    /**
     * Форма отправлена слишком быстро или давно: бывает и у живого посетителя (автозаполнение, долго открытая вкладка),
     * поэтому ему показывают ошибку, а не «Спасибо!».
     */
    public function isOutOfTime(): bool
    {
        $seconds = $this->secondsSinceShown();

        return $seconds !== null && ($seconds < self::MIN_SECONDS || $seconds > self::MAX_SECONDS);
    }

    /**
     * Сколько секунд назад показали форму; null — метки нет или она подделана.
     */
    private function secondsSinceShown(): ?int
    {
        try {
            [$shownAt, $session] = explode('|', Crypt::decryptString((string) $this->input('form_token')).'|', 3);
        } catch (DecryptException) {
            return null;
        }

        // Метка выдана этой сессии: чужую (украденную или собранную заранее) форма не принимает.
        return hash_equals($this->session()->getId(), $session) ? now()->timestamp - (int) $shownAt : null;
    }
}
