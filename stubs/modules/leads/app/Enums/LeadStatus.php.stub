<?php

declare(strict_types=1);

namespace {{ appNamespace }}\Enums;

/**
 * Статус заявки: подписи и цвет метки в админке.
 */
enum LeadStatus: string
{
    case New = 'new';
    case InWork = 'in_work';
    case Done = 'done';
    case Spam = 'spam';

    /**
     * Подпись в админке.
     */
    public function label(): string
    {
        return match ($this) {
            self::New => 'Новая',
            self::InWork => 'В работе',
            self::Done => 'Выполнена',
            self::Spam => 'Спам',
        };
    }

    /**
     * Цвет метки: success, warning, danger, info или neutral.
     */
    public function tone(): string
    {
        return match ($this) {
            self::New => 'info',
            self::InWork => 'warning',
            self::Done => 'success',
            self::Spam => 'neutral',
        };
    }
}
