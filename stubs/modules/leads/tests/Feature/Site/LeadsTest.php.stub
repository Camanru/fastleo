<?php

declare(strict_types=1);

use {{ appNamespace }}\Models\Lead;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Crypt;
use Illuminate\Support\Str;

uses(RefreshDatabase::class);

beforeEach(function (): void {
    // Посетитель с постоянной сессией: метка времени формы привязана к её номеру.
    $this->sessionId = Str::random(40);
    $this->withCookie(config('session.cookie'), $this->sessionId);
});

/**
 * Метка времени формы, показанной посетителю `$secondsAgo` секунд назад.
 */
function leadToken(int $secondsAgo = 60): string
{
    return Crypt::encryptString((now()->timestamp - $secondsAgo).'|'.test()->sessionId);
}

it('saves a lead from the site form', function (): void {
    $this->post('/leads', ['name' => 'Иван', 'phone' => '+7 900 000-00-00', 'form_token' => leadToken()])
        ->assertRedirect()
        ->assertSessionHas('lead_sent');

    expect(Lead::query()->where('name', 'Иван')->exists())->toBeTrue();
});

it('checks the fields of the form', function (): void {
    $this->post('/leads', ['name' => '', 'phone' => 'abc', 'email' => 'не почта', 'form_token' => leadToken()])
        ->assertSessionHasErrors(['name', 'phone', 'email']);

    expect(Lead::query()->count())->toBe(0);
});

it('ignores a status sent by the visitor', function (): void {
    $this->post('/leads', ['name' => 'Иван', 'phone' => '+7 900 000-00-00', 'status' => 'done', 'form_token' => leadToken()]);

    expect(Lead::query()->firstOrFail()->status->value)->toBe('new');
});

it('silently drops bots', function (): void {
    $this->post('/leads', ['name' => 'Бот', 'phone' => '+7 900 000-00-00', 'leave_empty' => 'http://spam.example', 'form_token' => leadToken()])->assertSessionHas('lead_sent');
    $this->post('/leads', ['name' => 'Бот', 'phone' => '+7 900 000-00-00'])->assertSessionHas('lead_sent');

    expect(Lead::query()->count())->toBe(0);
});

it('asks a living visitor to repeat when the form was sent too fast or is stale', function (): void {
    $this->post('/leads', ['name' => 'Иван', 'phone' => '+7 900 000-00-00', 'form_token' => leadToken(0)])->assertSessionHasErrors('form_token');
    $this->post('/leads', ['name' => 'Иван', 'phone' => '+7 900 000-00-00', 'form_token' => leadToken(86401)])->assertSessionHasErrors('form_token');

    expect(Lead::query()->count())->toBe(0);
});

it('limits forms from one address', function (): void {
    foreach (range(1, 5) as $ignored) {
        $this->post('/leads', ['name' => 'Иван', 'phone' => '+7 900 000-00-00', 'form_token' => leadToken()]);
    }

    $this->post('/leads', ['name' => 'Иван', 'phone' => '+7 900 000-00-00', 'form_token' => leadToken()])->assertTooManyRequests();
});
