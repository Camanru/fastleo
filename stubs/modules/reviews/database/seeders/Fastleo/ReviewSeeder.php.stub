<?php

declare(strict_types=1);

namespace Database\Seeders\Fastleo;

use {{ namespace }}\Models\Review;
use Illuminate\Database\Seeder;

/**
 * Примеры отзывов (php artisan db:seed --class=ReviewSeeder).
 */
class ReviewSeeder extends Seeder
{
    /**
     * Создать три отзыва, если таких авторов ещё нет.
     */
    public function run(): void
    {
        foreach ([1 => 'Анна Смирнова', 2 => 'Игорь Петров', 3 => 'Мария Иванова'] as $number => $author) {
            Review::query()->firstOrCreate(['author' => $author], [
                'company' => 'Клиент',
                'rating' => 5,
                'body' => 'Всё понравилось: быстро, аккуратно и по делу. Свои отзывы добавьте в панели: раздел «Отзывы».',
                'reviewed_at' => now()->subDays($number * 10),
                'is_published' => true,
                'sort' => $number,
            ]);
        }
    }
}
